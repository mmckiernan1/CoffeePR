# Coffee Payroll authentication (Supabase Auth)
# Never commit real keys. Copy this file to your local environment/host settings.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Turn on route protection only after the Supabase project and providers are configured.
COFFEE_PAYROLL_AUTH_REQUIRED=false
